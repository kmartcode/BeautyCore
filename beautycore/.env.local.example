# ─── Database ───────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string.
# Get one free at https://neon.tech — create a project, copy the pooled
# connection string from the dashboard.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require


# ─── AI: photo analysis (required) ──────────────────────────────────────────
# Google Gemini API key — powers the AI Advisor's vision analysis.
# Free tier is sufficient. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional. Defaults to gemini-flash-latest, an alias Google keeps pointed at a
# current model. Several gemini-2.5-* ids are closed to new keys and return 404,
# so prefer the alias unless you have a specific reason not to.
# GEMINI_MODEL=gemini-flash-latest


# ─── Sessions (required) ────────────────────────────────────────────────────
# Signing key for the JWT session cookie. Generate a fresh one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=generate_a_long_random_string_here


# ─── AI: preview generation (optional) ──────────────────────────────────────
# Which provider renders style previews on the client's photo.
#   stub    (default) — no previews; analysis still works and the UI explains why
#   lora              — your own LoRA served over HTTP (see scripts/colab_lora_server.py)
#   gemini            — Google image models; REQUIRES a billed Google Cloud account
#                       (free tier returns 429 with quota limit: 0)
PREVIEW_PROVIDER=stub

# Required when PREVIEW_PROVIDER=lora.
# The tunnel URL printed by scripts/colab_lora_server.py. This changes every
# time the Colab notebook restarts — re-paste it each session.
# LORA_ENDPOINT_URL=https://your-tunnel.trycloudflare.com

# Optional, only when PREVIEW_PROVIDER=gemini.
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
